# Copy to .env and edit. .env is git-ignored. Nothing here is a real secret:
# the values below are throwaway LOCAL-DEV defaults for containers on your machine only.

# --- Object storage (MinIO locally; real S3 later) ---------------------------------
# Leave S3_ENDPOINT_URL empty when pointing at real AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minio-local-user
S3_SECRET_ACCESS_KEY=minio-local-password-change-me
S3_REGION=us-east-1
S3_RAW_BUCKET=c311-raw
S3_CURATED_BUCKET=c311-curated

# --- Warehouse (Postgres locally; cloud warehouse later) ---------------------------
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse-local-password-change-me

# --- Airflow metadata DB (same Postgres instance, separate database) ----------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow-local-password-change-me
AIRFLOW_DB=airflow
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin-local-password-change-me

# --- Source API ---------------------------------------------------------------------
# Optional but recommended: a Socrata app token raises your throttling ceiling.
# Sent as the X-App-Token header. Leave blank to run unauthenticated (slower, may 429).
SOCRATA_APP_TOKEN=

# --- Pipeline overrides (everything else lives in config/pipeline.yaml) -------------
C311_CONFIG_PATH=config/pipeline.yaml
C311_LOG_LEVEL=INFO
